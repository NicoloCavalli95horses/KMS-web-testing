		{
			"id":"4bba224cfdae4fed",
			"type":"text",
			"text":"the HTML is the output of a logic process",
			"styleAttributes":{},
			"x":-660,
			"y":-630,
			"width":280,
			"height":100
		},
		{
			"id":"74a5cdbcdf073df5",
			"type":"text",
			"text":"client-side logic has precise information about what is rendered and why",
			"styleAttributes":{},
			"x":-1140,
