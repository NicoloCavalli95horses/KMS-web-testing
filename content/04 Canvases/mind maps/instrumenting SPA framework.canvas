		},
		{
			"id":"88013b8327d7a5e8",
			"type":"text",
			"text":"Current metamorphic relations consider data in the HTML",
			"styleAttributes":{},
			"x":-1300,
			"y":140,
			"width":300,
			"height":100
		},
		{"id":"1b5bce93e619da21","type":"file","file":"97 Assets/icse_review_strengths.png","x":-1265,"y":-1220,"width":965,"height":240},
		{"id":"a28ddec105cd19d6","type":"file","file":"97 Assets/mr_example.png","x":-660,"y":49,"width":628,"height":191},
		{
			"id":"a01f5c48961c51e7",
			"type":"text",
			"text":"https://ieeexplore.ieee.org/document/9159060",
			"styleAttributes":{},
			"x":-660,
			"y":240,
			"width":620,
			"height":60
		},
		{
			"id":"1450b169aba9eb2a",
			"type":"text",
			"text":"### What if we built a tool that gives to you run-time information about SPA-components, without launching the browser?",
			"styleAttributes":{},
			"x":-1340,
			"y":400,
			"width":520,
			"height":140
		},
		{
			"id":"8365cdfe40ec9fb2",
			"type":"text",
			"text":"# server",
			"styleAttributes":{"textAlign":"center"},
			"x":-1150,
			"y":660,
			"width":130,
			"height":60
		},
		{
			"id":"ad3bda80b9f2a0de",
			"type":"text",
			"text":"# client",
			"styleAttributes":{"textAlign":"center"},
			"x":-830,
			"y":660,
			"width":130,
			"height":60
		},
		{
			"id":"4c16e350a6dac777",
			"type":"text",
			"text":"- launch playwright to get the JS bundle and enable our isntrumentation\n- a database is created\n- a server responds to query to the database",
			"styleAttributes":{},
			"x":-830,
			"y":760,
			"width":320,
			"height":220
		},
		{
			"id":"5c816311cc8592e0",
			"type":"text",
			"text":"# we could **anticipate** the GUI behaviour by analyzing the database/graph",
			"styleAttributes":{},
			"x":-1300,
			"y":1100,
			"width":440,
			"height":200
		},
		{
			"id":"fec601340e81e19a",
			"type":"text",
			"text":"# this may lead to automatically generate E2E tests from code bundle!",
			"styleAttributes":{},
			"x":-700,
			"y":1100,
			"width":350,
			"height":200
		},
		{
			"id":"a8e566d4853198fd",
			"type":"text",
			"text":"```javascript\nfunction ExportPanel({ isPremium, projectId }) {\n  const [showDialog, setShowDialog] = useState(false);\n\n  if (!isPremium) return <UpgradePrompt />;\n\n  return (\n    <>\n      <button onClick={() => setShowDialog(true)}>\n        Export\n      </button>\n\n      {showDialog && (\n        <ExportDialog projectId={projectId} />\n      )}\n    </>\n  );\n}\n\n```",
			"styleAttributes":{},
			"x":-1500,
			"y":1380,
			"width":580,
			"height":520
		},
		{
			"id":"d946b5e15b999ff3",
			"type":"text",
			"text":"```javascript\ntest(\"Export opens the dialog\", async ({ page }) => {\n  await page.goto(\"/editor\");\n\n  await page.getByRole(\"button\", { name: \"Export\" }).click();\n\n  await expect(\n    page.getByRole(\"dialog\")\n  ).toBeVisible();\n});\n```",
			"styleAttributes":{},
			"x":-765,
			"y":1440,
			"width":700,
			"height":460
		}
	],
