{
	"nodes":[
		{
			"id":"2e28547f490dd4b9",
			"type":"text",
			"text":"# Exposed resources (IDOR/BOLA)",
			"styleAttributes":{"textAlign":"center","border":"invisible"},
			"x":-206,
			"y":-560,
			"width":620,
			"height":100
		},
		{
			"id":"67a5d5d529ee5ab9",
			"type":"text",
			"text":"### How to automate the exploration?",
			"styleAttributes":{"textAlign":"center"},
			"x":-1240,
			"y":920,
			"width":320,
			"height":120
		},
		{
			"id":"5f86768b5539c77c",
			"type":"text",
			"text":"proxy-server that tampers with HTTP requests",
			"styleAttributes":{"textAlign":"center","border":"invisible"},
			"x":-800,
			"y":920,
			"width":320,
			"height":120
		},
		{
			"id":"aff0c86fc0cfb177",
			"type":"text",
			"text":"### Capture and replay?",
			"styleAttributes":{"border":"invisible"},
			"x":960,
			"y":860,
			"width":340,
			"height":60
		},
		{
			"id":"8adc95d9cdc52042",
			"type":"text",
			"text":"### Page-Agent?",
			"styleAttributes":{"border":"invisible"},
			"x":960,
			"y":980,
			"width":340,
			"height":60
		},
		{
			"id":"0bf6fee9ac436879",
			"type":"text",
			"text":"### GUI explorer?",
			"styleAttributes":{"border":"invisible"},
			"x":960,
			"y":1100,
			"width":340,
			"height":60
		},
		{
			"id":"093bda3684516a97",
			"type":"text",
			"text":"brute-force DFS exploration algorithm works \"in theory\". In practice, real-world large SPA are very unpredictable and the exploration is not consistent over time",
			"styleAttributes":{"border":"invisible"},
			"x":1440,
			"y":1130,
			"width":560,
			"height":190
		},
		{
			"id":"850297b3cbf3ea9b",
			"type":"text",
			"text":"not deterministic and computationally very expensive (cannot run locally)",
			"styleAttributes":{"border":"invisible"},
			"x":1440,
			"y":920,
			"width":560,
			"height":120
		},
		{
			"id":"e997becd52f9b71b",
			"type":"text",
			"text":"the tampered front-end will display a different behavior\n- enabled DOM elements (buttons/sidebar)\n- direct access to restricted pages \n- modified HTTP requests\n- novel HTTP requests",
			"styleAttributes":{
				"textAlign":null,
				"border":"invisible"
			},
			"x":-330,
			"y":790,
			"width":560,
			"height":380
		},
		{
			"id":"431b96704e4a079c",
			"type":"text",
			"text":"Approached tried from late June (2 months already)",
			"styleAttributes":{},
			"x":800,
			"y":560,
			"width":520,
			"height":120
		},
		{
			"id":"3736c4a01c4453da",
			"type":"text",
			"text":"cannot replay the actions recorded during the \"capture\" phase. The FE has a different DOM after the tampering",
			"styleAttributes":{"border":"invisible"},
			"x":1440,
			"y":660,
			"width":600,
			"height":180
		},
		{
			"id":"4037fedb56ce88ed",
			"type":"text",
			"text":"# TSE paper : empirical study on real-world BAC\n#### How can we save the paper? And is it really worth it?\n",
			"styleAttributes":{"border":"invisible"},
			"x":-1240,
			"y":620,
			"width":880,
			"height":160
		},
		{"id":"575527d0887820b3","type":"file","file":"97 Assets/proxy-server-python.png","x":-840,"y":1100,"width":625,"height":673},
		{
			"id":"58f78eef86953662",
			"type":"text",
			"text":"but it works on toy application",
			"styleAttributes":{"border":"invisible"},
			"x":2080,
			"y":1185,
			"width":400,
			"height":80
		},
		{
			"id":"e1c990ad803af36d",
			"type":"text",
			"text":"+1 months",
			"styleAttributes":{"border":"invisible","textAlign":"center"},
			"x":759,
			"y":1377,
			"width":168,
			"height":60
		},
		{
			"id":"2599aabe8ef148b9",
			"type":"text",
			"text":"# Let's say that we find a solution to this...\n### We then must run it on 50+ apps (multiple times) to collect and analyze data reliably\n\n### The high-diversity of the set of apps makes the automatic interaction very challenging",
			"styleAttributes":{
				"border":"invisible",
				"textAlign":null
			},
			"x":340,
			"y":1437,
			"width":587,
			"height":443
		},
		{
			"id":"18d4f491deb05cb9",
			"type":"text",
			"text":"# we need to interact with the tampered front-end to reveal and study this new behavior",
			"styleAttributes":{
				"border":null,
				"textAlign":"center"
			},
			"x":394,
			"y":860,
			"width":480,
			"height":240,
			"color":"2"
		},
		{
			"id":"4fe8f13ee008ed1e",
			"type":"text",
			"text":"https://conf.researchr.org/track/saner-2027/saner-2027-short-papers-and-posters-track\nhttps://conf.researchr.org/track/saner-2027/saner-2027-early-research-achievement-era--track",
			"styleAttributes":{"border":"invisible"},
			"x":-1210,
			"y":2560,
			"width":1090,
			"height":200
		},
		{"id":"f8e51620cf4d07ee","type":"file","file":"Pasted image 20260825105859.png","x":-81,"y":2400,"width":1430,"height":740},
		{
			"id":"3ce661f37d54fc42",
